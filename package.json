{
  "name": "@local/python-env-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Discover local Python interpreters and remember a profile-wide interpreter for sandboxed agent tasks.",
  "type": "module",
  "exports": { ".": "./index.mjs", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.mjs", "discover.mjs", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "engines": { "dsh": ">=0.2.2-rc.5 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}